android_test {
    name: "DialerTests",

    srcs: [
        "src/**/*.java",
        "src/**/*.kt",
    ],
    manifest: "AndroidManifest.xml",
    test_config: "AndroidTest.xml",

    instrumentation_for: "DialerForTesting",
    certificate: "shared",
    platform_apis: true,
    java_version: "1.8",

    static_libs: [
        "androidx.test.core",
        "androidx.test.ext.junit",
        "androidx.test.runner",
        "androidx.test.rules",
        "kotlinx_coroutines",
        "kotlinx_coroutines_test",
        "mockito-target-inline-minus-junit4",
        "truth",
    ],

    libs: [
        "android.test.runner.stubs.system",
        "android.test.base.stubs.system",
        "android.test.mock.stubs.system",
    ],

    jni_libs: [
        // Required by mockito-target-inline-minus-junit4 to mock final classes on device.
        "libdexmakerjvmtiagent",
    ],

    data: [":DialerForTesting"],

    test_suites: ["device-tests"],
}

android_test {
    name: "DialerIntegrationTests",

    srcs: [
        "integration/src/**/*.java",
        "integration/src/**/*.kt",
    ],
    manifest: "integration/AndroidManifest.xml",
    test_config: "integration/AndroidTest.xml",

    instrumentation_for: "DialerForTesting",
    certificate: "shared",
    platform_apis: true,
    java_version: "1.8",

    static_libs: [
        "androidx.test.core",
        "androidx.test.ext.junit",
        "androidx.test.runner",
        "androidx.test.rules",
        "androidx.test.uiautomator_uiautomator",
        "kotlinx_coroutines",
        "truth",
    ],

    libs: [
        "android.test.runner.stubs.system",
        "android.test.base.stubs.system",
        "android.test.mock.stubs.system",
    ],

    data: [
        ":DialerForTesting",
        ":DialerIntegrationConnectionService",
    ],

    test_suites: ["device-tests"],
}

android_test {
    name: "DialerOutOfProcessTests",

    srcs: ["outofprocess/src/**/*.java"],
    manifest: "outofprocess/AndroidManifest.xml",
    test_config: "outofprocess/AndroidTest.xml",

    certificate: "shared",
    platform_apis: true,
    java_version: "1.8",

    static_libs: [
        "androidx.test.core",
        "androidx.test.ext.junit",
        "androidx.test.runner",
        "androidx.test.rules",
        "androidx.test.uiautomator_uiautomator",
        "truth",
    ],

    libs: [
        "android.test.runner.stubs.system",
        "android.test.base.stubs.system",
        "android.test.mock.stubs.system",
    ],

    data: [
        ":DialerForTesting",
        ":DialerIntegrationConnectionService",
    ],

    test_suites: ["device-tests"],
}
